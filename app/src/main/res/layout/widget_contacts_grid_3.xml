<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@android:color/transparent" android:padding="4dp">
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <GridView android:id="@+id/contacts_grid" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:columnWidth="82dp" android:gravity="center" android:horizontalSpacing="12dp" android:numColumns="3" android:scrollbars="none" android:stretchMode="columnWidth" android:verticalSpacing="12dp"/>
  <TextView android:id="@+id/empty_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="אין אנשי קשר" android:textColor="#CCFFFFFF" android:textSize="13sp" android:visibility="gone"/>
 </FrameLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
  <LinearLayout android:id="@+id/task_quick_card" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_action_bg" android:layout_marginEnd="4dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋ משימה" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp"/>
   <TextView android:id="@+id/task_quick_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="הוספה מהירה" android:textColor="#B8FFFFFF" android:textSize="10sp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/reminder_quick_card" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_action_bg" android:layout_marginStart="4dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋ תזכורת" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp"/>
   <TextView android:id="@+id/reminder_quick_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="להיום" android:textColor="#B8FFFFFF" android:textSize="10sp"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>